. do p13b_E_densities dgp

. * p13b_E_densities.do -- called by p13_profile_delta.do (Paper, version 5,
. * Section 7.5): the delta-method standard error of E with two densities for
. * the quantile-regression influence function, judged by the SAME draws of
. * p13a_E_draws.do (the draws do not depend on how the standard error is
. * computed):
. *   Powell kernel     : one bandwidth for every household (qreg vce(robust, k
> ernel));
. *   Hendricks-Koenker : each household's own density 2h/(x'b(u+h) - x'b(u-h))
. *                       (qreg's default vce(robust)); Siddiqui quotient for q
> _tau.
. * Argument: dgp | bkf.  Checks: the Stata form u(1-u) H X'X H of both
. * reproduces e(V) of qreg; the point E equals p13a's.  Report: the two
. * standard errors against the standard deviation of the draws -- the numbers
. * of Section 7.5.  It does not call gepwreg.
. version 16

. clear all

. args what

. set more off

. set varabbrev off

. local OUT "results"

. capture mkdir "results"

. local tau 0.25

. global TAU `tau'

. numlist "0.05(0.05)0.95"

. global UG `r(numlist)'

. 
. mata:
------------------------------------------------- mata (type end to exit) -----
: real matrix _psiK(real matrix Xt, real colvector r, real colvector kv,
>                   real scalar kb, real scalar u)
> {
>     real matrix    H
>     real colvector s
>     H = invsym(quadcross(Xt, kv, Xt) / kb)
>     s = (u :- (r :< 0)) :* (abs(r) :>= 1e-10)
>     return((Xt :* s) * H)
> }

: 
: real matrix _psiF(real matrix Xt, real colvector r, real colvector f, real sc
> alar u)
> {
>     real matrix    H
>     real colvector s
>     H = invsym(quadcross(Xt, f, Xt))
>     s = (u :- (r :< 0)) :* (abs(r) :>= 1e-10)
>     return((Xt :* s) * H)
> }

: 
: // check (1): both Stata forms against e(V) of the two qreg runs; row g of _C
> HK
: void _chk(real scalar g, real scalar u, string scalar vk, string scalar vf,
>           real scalar kb, string scalar rname, string scalar kname,
>           string scalar fname, string scalar xv)
> {
>     real matrix    X, Xt, HK, HF, C
>     real colvector kv, f
>     real scalar    n
>     X  = (strlen(xv) ? st_data(., tokens(xv)) : J(st_nobs(), 0, .))
>     n  = rows(X)
>     Xt = (X, J(n, 1, 1))
>     kv = st_data(., kname)
>     f  = st_data(., fname)
>     HK = invsym(quadcross(Xt, kv, Xt) / kb)
>     HF = invsym(quadcross(Xt, f, Xt))
>     C  = st_matrix("_CHK")
>     C[g, 1] = max(abs(sqrt(diagonal(u*(1-u) * HK * quadcross(Xt, Xt) * HK)) :
> / sqrt(diagonal(st_matrix(vk))) :- 1))
>     C[g, 2] = max(abs(sqrt(diagonal(u*(1-u) * HF * quadcross(Xt, Xt) * HF)) :
> / sqrt(diagonal(st_matrix(vf))) :- 1))
>     st_matrix("_CHK", C)
> }
note: argument rname unused.

: 
: real rowvector _E_seg(real matrix G, real rowvector ug, real scalar q,
>                       real rowvector xt, real scalar ustar, real scalar seg,
>                       real scalar tt)
> {
>     real scalar    ng
>     real rowvector Qr
>     ng = cols(ug)
>     Qr = xt * G'
>     if (q <= Qr[1]) {
>         seg = 1
>         tt  = 0
>     }
>     else if (q >= Qr[ng]) {
>         seg = ng - 1
>         tt  = 1
>     }
>     else {
>         seg = max(selectindex(Qr :<= q))
>         tt  = (q - Qr[seg]) / (Qr[seg+1] - Qr[seg])
>     }
>     ustar = ug[seg] + tt * (ug[seg+1] - ug[seg])
>     return((1 - tt) * G[seg, .] + tt * G[seg+1, .])
> }

: 
: // block of one reference: E (k), SE kernel (k), SE Hendricks-Koenker (k), u*
> , segment
: real rowvector _E_ref2(real matrix G, real rowvector ug, real scalar q,
>                        real colvector PQK, real colvector PQF, real matrix X,
>                        real rowvector xr, real rowvector flag, real colvector
>  KB)
> {
>     real scalar    n, k, ustar, seg, tt, D, j, clip, m
>     real rowvector xt, bs, xbar, out, Qr
>     real matrix    Xt, P1, P2, Pstar
>     real colvector core, psi, r1, r2
>     n  = rows(X)
>     k  = cols(X)
>     Xt = (X, J(n, 1, 1))
>     xt = (xr, 1)
>     ustar = .
>     seg   = .
>     tt    = .
>     bs = _E_seg(G, ug, q, xt, ustar, seg, tt)
>     Qr = xt * G'
>     clip = (q <= Qr[1] | q >= Qr[cols(Qr)])
>     D  = xt * (G[seg+1, .] - G[seg, .])'
>     r1 = st_data(., "_r" + strofreal(seg))
>     r2 = st_data(., "_r" + strofreal(seg + 1))
>     xbar = mean(X)
>     out  = J(1, 3*k + 2, .)
>     out[1..k] = bs[1..k]
>     for (m = 1; m <= 2; m++) {
>         if (m == 1) {
>             P1 = _psiK(Xt, r1, st_data(., "_k" + strofreal(seg)),     KB[seg]
> ,     ug[seg])
>             P2 = _psiK(Xt, r2, st_data(., "_k" + strofreal(seg + 1)), KB[seg 
> + 1], ug[seg + 1])
>             core = PQK
>         }
>         else {
>             P1 = _psiF(Xt, r1, st_data(., "_f" + strofreal(seg)),     ug[seg]
> )
>             P2 = _psiF(Xt, r2, st_data(., "_f" + strofreal(seg + 1)), ug[seg 
> + 1])
>             core = PQF
>         }
>         Pstar = (1 - tt) * P1 + tt * P2
>         core  = core - Pstar * xt'
>         for (j = 1; j <= k; j++) {
>             if (flag[j]) core = core - ((X[., j] :- xbar[j]) / n) * bs[j]
>         }
>         if (clip) core = J(n, 1, 0)
>         for (j = 1; j <= k; j++) {
>             psi = Pstar[., j] + ((G[seg+1, j] - G[seg, j]) / D) * core
>             psi = psi :- mean(psi)
>             out[m*k + j] = sqrt(quadcross(psi, psi))
>         }
>     }
>     out[3*k + 1] = ustar
>     out[3*k + 2] = seg
>     return(out)
> }

: 
: void _E_run2(real scalar qh, real scalar qkb)
> {
>     real matrix    X, G
>     real rowvector ug, xr, fl, xf, out
>     real colvector KB, PQK, PQF
>     real scalar    n, tau
>     G   = st_matrix("_Gr")
>     ug  = strtoreal(tokens(st_global("UG")))
>     tau = strtoreal(st_global("TAU"))
>     xr  = st_matrix("_XR")
>     fl  = st_matrix("_FL")
>     xf  = strtoreal(tokens(st_global("XFIX")))
>     X   = st_data(., tokens(st_global("XV")))
>     n   = rows(X)
>     KB  = st_matrix("_KB")
>     PQK = _psiK(J(n, 1, 1), st_data(., "_rq"), st_data(., "_kq"), qkb, tau)
>     PQF = _psiF(J(n, 1, 1), st_data(., "_rq"), st_data(., "_fq"), tau)
>     out = _E_ref2(G, ug, qh, PQK, PQF, X, xr, fl, KB)
>     if (cols(xf)) out = (out, _E_ref2(G, ug, qh, PQK, PQF, X, xf, J(1, cols(x
> f), 0), KB))
>     st_matrix("_Eres", out)
> }

: 
: void _ref_dgp()
> {
>     real colvector x1, x2
>     x1 = st_data(., "x1")
>     x2 = st_data(., "x2")
>     st_matrix("_XR", (mean(x1), mean(x2) > 0.5))
>     st_matrix("_FL", (1, 0))
> }

: 
: void _ref_bkf()
> {
>     real colvector s, m, u, g
>     real rowvector cnt, xr, top
>     real scalar    l, gm
>     s = st_data(., "size")
>     m = st_data(., "male")
>     u = st_data(., "urban")
>     g = st_data(., "gse")
>     cnt = J(1, 7, 0)
>     for (l = 1; l <= 7; l++) cnt[l] = sum(g :== l)
>     top = selectindex(cnt :== max(cnt))
>     gm  = top[1]
>     xr = (mean(s), mean(m) > 0.5, mean(u) > 0.5)
>     for (l = 2; l <= 7; l++) xr = (xr, gm == l)
>     st_matrix("_XR", xr)
>     st_matrix("_FL", (1, J(1, 8, 0)))
> }

: 
: void _report4(real rowvector E0, real matrix TT, string rowvector names,
>               real scalar nref, string rowvector rlab)
> {
>     real scalar    k, r, j, B, base, ie, sd, rob
>     real colvector e, srt
>     k = cols(names)
>     B = rows(TT)
>     for (r = 1; r <= nref; r++) {
>         base = (r - 1) * (3*k + 2)
>         printf("\n  reference: %s -- u* %6.4f (segment %g)\n", rlab[r], E0[ba
> se + 3*k + 1], E0[base + 3*k + 2])
>         printf("  coefficient     point   SE_kern     SE_HK   SD_boot  robust
>  SD  kern/SD    HK/SD   HK/rob\n")
>         for (j = 1; j <= k; j++) {
>             ie  = base + j
>             e   = TT[., ie]
>             sd  = sqrt(variance(e))
>             srt = sort(e, 1)
>             rob = (srt[ceil(0.75*B)] - srt[ceil(0.25*B)]) / 1.349
>             printf("  %-12s %8.4f  %8.4f  %8.4f  %8.4f   %8.4f   %6.3f   %6.3
> f   %6.3f\n",
>                    names[j], E0[ie], E0[ie + k], E0[ie + 2*k], sd, rob,
>                    E0[ie + k] / sd, E0[ie + 2*k] / sd, E0[ie + 2*k] / rob)
>         }
>     }
> }

: end
-------------------------------------------------------------------------------

. 
. * the point of E with both SEs -> _Eres; _CHK holds check (1)
. capture program drop _E_point2

. program define _E_point2
  1.     quietly {
  2.         local k  : word count $XV
  3.         local ng : word count $UG
  4.         matrix _Gr  = J(`ng', `k' + 1, .)
  5.         matrix _KB  = J(`ng', 1, .)
  6.         matrix _CHK = J(`ng' + 1, 2, .)
  7.         tempname VK VF
  8.         local g 0
  9.         foreach u of global UG {
 10.             local ++g
 11.             qreg $Y $XV, quantile(`u') vce(robust, kernel)
 12.             matrix `VK' = e(V)
 13.             local kb = e(kbwidth)
 14.             matrix _KB[`g', 1] = `kb'
 15.             capture drop _r`g' _k`g' _f`g'
 16.             predict double _r`g', residuals
 17.             generate double _k`g' = 0.75*(1 - 0.2*(_r`g'/`kb')^2)/sqrt(5) 
> * (abs(_r`g'/`kb') < sqrt(5))
 18.             qreg $Y $XV, quantile(`u') vce(robust)
 19.             matrix `VF' = e(V)
 20.             local j 0
 21.             foreach v of global XV {
 22.                 local ++j
 23.                 matrix _Gr[`g', `j'] = _b[`v']
 24.             }
 25.             matrix _Gr[`g', `k' + 1] = _b[_cons]
 26.             local h = e(bwidth)
 27.             * qreg's fitted method (VCE_fitted in qreg.ado)
.             _qreg $Y $XV, quant(`=`u' - `h'')
 28.             predict double _xl, xb
 29.             _qreg $Y $XV, quant(`=`u' + `h'')
 30.             predict double _xu, xb
 31.             generate double _f`g' = cond(_xu - _xl > sqrt(c(epsdouble)), 2
> *`h'/(_xu - _xl), 0)
 32.             drop _xl _xu
 33.             mata: _chk(`g', `u', "`VK'", "`VF'", `kb', "_r`g'", "_k`g'", "
> _f`g'", "$XV")
 34.         }
 35.         local g = `ng' + 1
 36.         qreg $Y, quantile($TAU) vce(robust, kernel)
 37.         matrix `VK' = e(V)
 38.         local qh  = _b[_cons]
 39.         local qkb = e(kbwidth)
 40.         capture drop _rq _kq _fq
 41.         generate double _rq = $Y - `qh'
 42.         generate double _kq = 0.75*(1 - 0.2*(_rq/`qkb')^2)/sqrt(5) * (abs(
> _rq/`qkb') < sqrt(5))
 43.         qreg $Y, quantile($TAU) vce(robust)
 44.         matrix `VF' = e(V)
 45.         local hq = e(bwidth)
 46.         _qreg $Y, quant(`=$TAU - `hq'')
 47.         local ql = _b[_cons]
 48.         _qreg $Y, quant(`=$TAU + `hq'')
 49.         local qu = _b[_cons]
 50.         generate double _fq = cond(`qu' - `ql' > sqrt(c(epsdouble)), 2*`hq
> '/(`qu' - `ql'), 0)
 51.         mata: _chk(`g', $TAU, "`VK'", "`VF'", `qkb', "_rq", "_kq", "_fq", 
> "")
 52.         mata: _ref_$REFTYPE()
 53.         mata: _E_run2(`qh', `qkb')
 54.     }
 55. end


  1.     args nobs s1 s2
  2.     quietly {
  3.         set obs `nobs'
  4.         generate double x1 = 1 + 8*runiform()
  5.         generate double x2 = runiform() < invlogit(-1 + 0.1*x1)
  6.         generate double u  = runiform()
  7.         generate double y  = invnormal(u) + (0.4 + `s1'*u)*x1 + (0.5 + `s2

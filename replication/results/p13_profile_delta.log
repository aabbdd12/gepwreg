. 
. * the point of E with both SEs -> _Eres; _CHK holds check (1)
. capture program drop _E_point2

. program define _E_point2
  1.     quietly {
  2.         local k  : word count $XV
  3.         local ng : word count $UG
  4.         matrix _Gr  = J(`ng', `k' + 1, .)
  5.         matrix _KB  = J(`ng', 1, .)
  6.         matrix _CHK = J(`ng' + 1, 2, .)
  7.         tempname VK VF
  8.         local g 0
  9.         foreach u of global UG {
 10.             local ++g
 11.             qreg $Y $XV, quantile(`u') vce(robust, kernel)
 12.             matrix `VK' = e(V)
 13.             local kb = e(kbwidth)
 14.             matrix _KB[`g', 1] = `kb'
 15.             capture drop _r`g' _k`g' _f`g'
 16.             predict double _r`g', residuals
 17.             generate double _k`g' = 0.75*(1 - 0.2*(_r`g'/`kb')^2)/sqrt(5) 
> * (abs(_r`g'/`kb') < sqrt(5))
 18.             qreg $Y $XV, quantile(`u') vce(robust)
 19.             matrix `VF' = e(V)
 20.             local j 0
 21.             foreach v of global XV {
 22.                 local ++j
 23.                 matrix _Gr[`g', `j'] = _b[`v']
 24.             }
 25.             matrix _Gr[`g', `k' + 1] = _b[_cons]
 26.             local h = e(bwidth)
 27.             * qreg's fitted method (VCE_fitted in qreg.ado)
.             _qreg $Y $XV, quant(`=`u' - `h'')
 28.             predict double _xl, xb
 29.             _qreg $Y $XV, quant(`=`u' + `h'')
 30.             predict double _xu, xb
 31.             generate double _f`g' = cond(_xu - _xl > sqrt(c(epsdouble)), 2
> *`h'/(_xu - _xl), 0)
 32.             drop _xl _xu
 33.             mata: _chk(`g', `u', "`VK'", "`VF'", `kb', "_r`g'", "_k`g'", "
> _f`g'", "$XV")
 34.         }
 35.         local g = `ng' + 1
 36.         qreg $Y, quantile($TAU) vce(robust, kernel)
 37.         matrix `VK' = e(V)
 38.         local qh  = _b[_cons]
 39.         local qkb = e(kbwidth)
 40.         capture drop _rq _kq _fq
 41.         generate double _rq = $Y - `qh'
 42.         generate double _kq = 0.75*(1 - 0.2*(_rq/`qkb')^2)/sqrt(5) * (abs(
> _rq/`qkb') < sqrt(5))
 43.         qreg $Y, quantile($TAU) vce(robust)
 44.         matrix `VF' = e(V)
 45.         local hq = e(bwidth)
 46.         _qreg $Y, quant(`=$TAU - `hq'')
 47.         local ql = _b[_cons]
 48.         _qreg $Y, quant(`=$TAU + `hq'')
 49.         local qu = _b[_cons]
 50.         generate double _fq = cond(`qu' - `ql' > sqrt(c(epsdouble)), 2*`hq
> '/(`qu' - `ql'), 0)
 51.         mata: _chk(`g', $TAU, "`VK'", "`VF'", `qkb', "_rq", "_kq", "_fq", 
> "")
 52.         mata: _ref_$REFTYPE()
 53.         mata: _E_run2(`qh', `qkb')
 54.     }
 55. end

. 

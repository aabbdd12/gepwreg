  5.         generate byte urban = (zone == 2)
  6.         forvalues l = 2/7 {
  7.             generate byte g`l' = (gse == `l')
  8.         }
  9.         keep lexp size male urban gse g2-g7
 10.         keep if !missing(lexp, size, male, urban, gse)
 11.     }
 12. end

